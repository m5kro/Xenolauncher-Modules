{
    "name": "Wine",
    "version": "0.1.0",
    "description": "IN BETA! A module to launch Windows games using Wine.",
    "author": "m5kro",
    "license": "GPL-3.0",
    "dependencies": {
        "version/11.7-staging": {
            "universal": {
                "link": "https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.7/wine-staging-11.7-osx64.tar.xz",
                "unzip": true
            }
        },
        "dxvkVersion/v1.10.3-20230507-repack": {
            "universal": {
                "link": "https://github.com/Gcenx/DXVK-macOS/releases/download/v1.10.3-20230507-repack/dxvk-macOS-async-v1.10.3-20230507-repack.tar.gz",
                "unzip": true
            }
        }
    },
    "autodetect": {
        "extensions": ["exe"],
        "all_required": false
    },
    "gameArgs": {
        "version": {
            "type": "multi-version",
            "label": "Wine Version",
            "version-script": "wine.js",
            "default": "11.7-staging"
        },
        "winePrefix": {
            "type": "string",
            "label": "Custom Wine Prefix (Blank for automatic prefix)",
            "default": ""
        },
        "enableDxvk": {
            "type": "boolean",
            "label": "Enable DXVK (Direct3D 10/11)",
            "default": false
        },
        "dxvkVersion": {
            "type": "multi-version",
            "label": "DXVK Version",
            "version-script": "dxvk.js",
            "default": "v1.10.3-20230507-repack"
        },
        "dxvkHud": {
            "type": "dropdown",
            "label": "DXVK HUD",
            "default": "off",
            "options": [
                { "label": "Off", "value": "off" },
                { "label": "FPS", "value": "fps" },
                { "label": "Devinfo + FPS", "value": "devinfo-fps" },
                { "label": "Full", "value": "full" }
            ]
        },
        "dxvkAsync": {
            "type": "boolean",
            "label": "Enable DXVK Async",
            "default": false
        }
    }
}
